{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/lead.js": { "includeFiles": "downloads/scheidungsunterlagen-checkliste.pdf", "maxDuration": 60 },
    "api/hq/[route].js": { "includeFiles": "{api/_templates/**,downloads/scheidungsunterlagen-checkliste.pdf}", "maxDuration": 60 },
    "api/m/[route].js": { "includeFiles": "downloads/scheidungsunterlagen-checkliste.pdf", "maxDuration": 30 },
    "api/cron/erinnerungen.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/erinnerungen", "schedule": "0 7 * * *" }
  ],
  "rewrites": [
    { "source": "/m/:token", "destination": "/mandant" },
    { "source": "/f/:token", "destination": "/mandant" },
    { "source": "/s/:token", "destination": "/mandant" }
  ],
  "headers": [
    {
      "source": "/hq",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(m|f|s)/:token",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/mandant",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
